{
  "expo": {
    "name": "EN-PL Translator",
    "slug": "translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#101014"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yosef.enpltranslator",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSpeechRecognitionUsageDescription": "This app transcribes speech so it can translate between English and Polish.",
        "NSMicrophoneUsageDescription": "This app uses the microphone to hear the conversation it is translating."
      }
    },
    "android": {
      "package": "com.yosef.enpltranslator",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101014"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "This app uses the microphone to hear the conversation it is translating.",
          "speechRecognitionPermission": "This app transcribes speech so it can translate between English and Polish."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "owner": "joc781227s-team",
    "extra": {
      "eas": {
        "projectId": "2fbd76ce-924b-43c6-890a-117dbce673f4"
      }
    }
  }
}
